    "What was audible? Any interruption?": {
      "extractionState": "manual",
      "shouldTranslate": false
    },
    "When you switch to another app, subtitles appear in a slim floating window.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかのアプリに切り替えると、細いフローティングウインドウに字幕が表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 앱으로 전환하면 자막이 얇은 플로팅 창에 나타납니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换到其他 App 时，字幕会显示在一个细长的悬浮窗里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "切換到其他 App 時，字幕會顯示在一個細長的懸浮視窗裡。"
          }
        }
      }
    },
