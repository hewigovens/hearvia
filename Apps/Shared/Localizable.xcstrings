    "1 kHz test tone playing": {
      "extractionState": "manual",
      "shouldTranslate": false
    },
    "A": {
      "extractionState": "manual",
      "shouldTranslate": false
    },
    "A few things iOS decides for us:": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS が決めていることがいくつかあります："
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS가 정하는 몇 가지가 있습니다:"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有几件事由 iOS 决定："
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有幾件事由 iOS 決定："
          }
        }
      }
    },
    "A red indicator stays in the status bar while Hearvia is listening. Tap it any time to stop.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Hearvia が聞いている間、ステータスバーに赤いインジケータが表示されます。タップすればいつでも停止できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Hearvia가 듣는 동안 상태 막대에 빨간색 표시가 나타납니다. 언제든 탭하면 중지됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hearvia 收听时，状态栏会一直显示红色指示器。随时轻点即可停止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Hearvia 收聽時，狀態列會一直顯示紅色指示器。隨時點一下即可停止。"
          }
        }
      }
    },
    "AIza…": {
      "extractionState": "manual",
      "shouldTranslate": false
    },
