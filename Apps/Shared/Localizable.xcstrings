    "Videos, podcasts, calls, or the person in front of you, translated as they speak.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画、Podcast、通話、目の前の人の話を、話すそばから翻訳します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동영상, 팟캐스트, 통화, 눈앞의 사람까지 말하는 즉시 번역합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "视频、播客、通话，或你面前的人——边说边翻译。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "影片、Podcast、通話，或你面前的人——邊說邊翻譯。"
          }
        }
      }
    },
