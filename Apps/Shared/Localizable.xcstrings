          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud로 다른 기기와 동기화됩니다. 기록을 삭제하면 모든 기기에서 삭제됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已通过 iCloud 同步到你的其他设备。删除记录会在所有设备上删除。"
