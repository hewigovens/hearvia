    "Both optional. Hearvia asks again when needed.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どちらも任意です。必要なときに改めて確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "둘 다 선택 사항입니다. 필요할 때 다시 묻습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两项都可选。需要时 Hearvia 会再次询问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "兩項都可選。需要時 Hearvia 會再次詢問。"
          }
        }
      }
    },
    "Browser audio? Choose All system audio.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザの音声は「すべてのシステム音声」を選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브라우저 소리는 ‘모든 시스템 오디오’를 선택하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "浏览器的声音？请选择“全部系统音频”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
