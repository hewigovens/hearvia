    "AVAudioEngine input, no voice processing, play & record + mix with others.": {
      "extractionState": "manual",
      "shouldTranslate": false
    },
    "Activate Session": {
      "extractionState": "manual",
      "shouldTranslate": false
    },
    "Add a %@ key in Settings": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定で %@ のキーを追加"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정에서 %@ 키 추가"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在设置中添加 %@ 密钥"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在設定中新增 %@ 金鑰"
          }
        }
      }
    },
    "All system audio": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
