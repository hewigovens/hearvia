    "Both optional. Hearvia asks again when they're needed.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どちらも任意です。必要になったときに Hearvia が改めて確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "둘 다 선택 사항입니다. 필요할 때 Hearvia가 다시 묻습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两项都是可选的。需要时 Hearvia 会再次询问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "兩項都是可選的。需要時 Hearvia 會再次詢問。"
          }
        }
      }
    },
    "Browser audio? Choose All system audio.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザの音声は「すべてのシステム音声」を選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브라우저 소리는 ‘모든 시스템 오디오’를 선택하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "浏览器的声音？请选择“全部系统音频”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "瀏覽器的聲音？請選擇「全部系統音訊」。"
          }
        }
      }
    },
    "Can't reach the local model server at %@: %@ If it's on another machine, allow Hearvia under Privacy & Security → Local Network.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ のローカルモデルサーバに接続できません：%@ 別のコンピュータ上にある場合は、「プライバシーとセキュリティ → ローカルネットワーク」で Hearvia を許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 로컬 모델 서버에 연결할 수 없습니다: %@ 다른 컴퓨터에 있다면 ‘개인정보 보호 및 보안 → 로컬 네트워크’에서 Hearvia를 허용하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接 %@ 上的本地模型服务器：%@ 如果它在另一台电脑上，请在“隐私与安全性 → 本地网络”中允许 Hearvia。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法連線到 %@ 上的本機模型伺服器：%@ 如果它在另一台電腦上，請在「隱私權與安全性 → 區域網路」中允許 Hearvia。"
          }
        }
      }
