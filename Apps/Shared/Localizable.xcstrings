    "Audio isolation / route experiment": {
      "extractionState": "manual",
      "shouldTranslate": false
    },
    "Audio stays on this Mac unless you use a cloud translator. Change access in System Settings → Privacy & Security.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラウドの翻訳を使わない限り、音声はこのMacから出ません。アクセスは「システム設定 → プライバシーとセキュリティ」で変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클라우드 번역기를 사용하지 않으면 오디오는 이 Mac에만 남습니다. 접근 권한은 ‘시스템 설정 → 개인정보 보호 및 보안’에서 바꿀 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "除非使用云端翻译器，否则音频只留在这台 Mac 上。可在“系统设置 → 隐私与安全性”中更改访问权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "除非使用雲端翻譯器，否則音訊只留在這台 Mac 上。可在「系統設定 → 隱私權與安全性」中更改取用權限。"
          }
        }
      }
    },
