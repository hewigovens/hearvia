    "Asked the first time you choose Microphone, to subtitle speech around you.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "初めてマイクを選んだときに確認します。周りの話し声に字幕を付けるためです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "처음 마이크를 선택할 때 요청합니다. 주변의 말소리에 자막을 달기 위한 것입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第一次选择麦克风时询问，用于为你周围的说话添加字幕。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "第一次選擇麥克風時詢問，用於為你周圍的說話新增字幕。"
          }
        }
      }
    },
    "Audio Source": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
