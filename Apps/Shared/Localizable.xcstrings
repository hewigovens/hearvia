    "Headphones and AirPods work fine — Hearvia hears the app, not the room.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘッドフォンや AirPods でも大丈夫です。Hearvia が聞くのはアプリの音で、部屋の音ではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "헤드폰과 AirPods도 괜찮습니다. Hearvia는 방 안의 소리가 아니라 앱의 소리를 듣습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "耳机和 AirPods 也没问题——Hearvia 听的是 App，不是房间里的声音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
