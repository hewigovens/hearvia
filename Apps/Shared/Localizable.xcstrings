    "Add an API key for %@ in Settings, or switch to on-device translation.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定で %@ の API キーを追加するか、デバイス上の翻訳に切り替えてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정에서 %@ API 키를 추가하거나 기기 내 번역으로 전환하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在设置中添加 %@ 的 API 密钥，或改用设备端翻译。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在設定中加入 %@ 的 API 金鑰，或改用裝置端翻譯。"
          }
        }
      }
    },
