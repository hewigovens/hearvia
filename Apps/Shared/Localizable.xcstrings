    "Auto-detect needs a downloaded speech language. Choose the spoken language once to download it.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動検出にはダウンロード済みの音声言語が必要です。一度話す言語を選んでダウンロードしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 감지에는 다운로드된 음성 언어가 필요합니다. 말하는 언어를 한 번 선택해 다운로드하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动检测需要已下载的语音语言。先选择一次说话语言来下载。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動偵測需要已下載的語音語言。先選擇一次說話語言來下載。"
          }
        }
      }
    },
    "Background": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "背景"
          }
