{
  "sourceLanguage": "en",
  "strings": {
    "\"%@\" isn't a server address. Use one like http://localhost:11434/v1.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」はサーバのアドレスではありません。http://localhost:11434/v1 のような形式で入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”은(는) 서버 주소가 아닙니다. http://localhost:11434/v1 같은 주소를 사용하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”不是服务器地址。请使用类似 http://localhost:11434/v1 的地址。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」不是伺服器位址。請使用類似 http://localhost:11434/v1 的位址。"
          }
        }
      }
    },
    "%@ has no remaining quota for this key. Try the on-device translator.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このキーでは %@ の利用枠が残っていません。デバイス上の翻訳をお試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 키로는 %@ 사용량이 남아 있지 않습니다. 기기 내 번역을 사용해 보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的这个密钥已没有额度。试试设备端翻译。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的這個金鑰已沒有額度。試試裝置端翻譯。"
          }
        }
      }
    },
    "%@ · %@ · %@": {
      "extractionState": "manual",
      "shouldTranslate": false
    },
    "%@ · possible %@ · frames %lld": {
      "extractionState": "manual",
      "shouldTranslate": false
    },
    "%@ · sent %lld × 200 ms · %lld deltas · %lld reconnects": {
      "extractionState": "manual",
      "shouldTranslate": false
    },
