          }
        }
      }
    },
    "http://localhost:11434/v1": {
      "extractionState": "manual",
      "shouldTranslate": false
    },
    "iOS only lets apps hear other apps' sound through screen sharing. When you tap the play button, choose **Share Entire Screen**.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS では、ほかのアプリの音声を聞くには画面共有を使うしかありません。再生ボタンをタップしたら **画面全体を共有** を選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS에서는 화면 공유를 통해서만 다른 앱의 소리를 들을 수 있습니다. 재생 버튼을 탭하면 **전체 화면 공유**를 선택하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 只允许 App 通过屏幕共享听到其他 App 的声音。轻点播放按钮后，请选择**共享整个屏幕**。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 只允許 App 透過螢幕分享聽到其他 App 的聲音。點一下播放按鈕後，請選擇**分享整個螢幕**。"
          }
        }
      }
    },
    "iOS will ask to share your screen": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS が画面共有を求めます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS가 화면 공유를 요청합니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 会请求共享你的屏幕"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 會請求分享你的螢幕"
          }
        }
      }
    },
    "macOS asks once for each way Hearvia listens.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Hearvia の聞き取り方法ごとに、macOS が一度だけ確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Hearvia가 듣는 방식마다 macOS가 한 번씩 묻습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hearvia 每种收听方式，macOS 都只会询问一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Hearvia 每種收聽方式，macOS 都只會詢問一次。"
          }
        }
      }
    },
