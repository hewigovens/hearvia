    "Only used by the Gemini Live translator. Get a free key at [aistudio.google.com](https://aistudio.google.com/apikey). Kept in this iPhone's Keychain.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemini Live の翻訳でのみ使います。キーは [aistudio.google.com](https://aistudio.google.com/apikey) で無料で取得できます。このiPhoneのキーチェーンに保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
